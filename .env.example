# Use 0.0.0.0 only when intentionally exposing the app directly on your LAN.
BIND_ADDRESS=127.0.0.1
PORT=8080
# Set to the full HTTPS origin behind your reverse proxy, or to http://YOUR-COMPUTER-IP:8080 for LAN play.
PUBLIC_ORIGIN=
# Published image tag to run; pin a build such as 1.0.7 to roll back.
IMAGE_TAG=latest
